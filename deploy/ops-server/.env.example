# Tailscale IPv4 of this server (tailscale ip -4). All ports bind to it.
TAILSCALE_IP=100.64.0.1
# vmalert posts alerts to <url>/api/v2/alerts (Alertmanager API), served by the ops-service.
ALERT_NOTIFIER_URL=http://ops-service:8030
# Bearer token of the alert webhook (POST /api/v2/alerts), at least 32 characters: openssl rand -hex 32.
# The same value goes into the file ./alert-token (mode 600) that vmalert reads; see docs/install-with-an-ai-agent.md.
# Empty: the webhook accepts every caller in the tailnet and the service logs a warning at startup.
ALERT_TOKEN=
# Image of the ops-service built by the pipeline.
OPS_IMAGE=pikett:latest
OPS_DB_PASSWORD=change-me
# Uptime Kuma's MariaDB (openssl rand -hex 24 for each). MariaDB reads them only when it creates its data directory:
# on a running server they must stay as they are, and `provision.sh deploy` copies this file over the server's.
KUMA_DB_PASSWORD=change-me
KUMA_DB_ROOT_PASSWORD=change-me
# Shared secret of the trivy-server and the Trivy clients on both servers (TRIVY_TOKEN in /etc/ops-collect.env).
TRIVY_TOKEN=
