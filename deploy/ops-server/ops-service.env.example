# Settings of the ops-service (see app/config.py). Copy to ops-service.env on the server; never commit it.
ENVIRONMENT=prod
# DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=INFO
# Bearer token of the alert webhook: set ALERT_TOKEN in .env next to compose.yml (and the same value in the file
# alert-token), not here. A value in this file is overridden by .env.
# Name shown in the web UI and the analysis prompt, and a few sentences about your stack for the analyst.
PROJECT_NAME=Acme
# LANGUAGE is en or de. TIMEZONE is an IANA time zone. It sets displayed times, the day of the digest and the AI budget, the on-call week, SSH quiet hours, the reboot window and how patch logs are read. Use the zone of your servers: the timers in deploy/ say Europe/Vienna.
LANGUAGE=en
TIMEZONE=UTC
AGENT_STACK_DESCRIPTION=A FastAPI backend (api) and a Next.js frontend (web) with Postgres, deployed with Coolify on one server.
BASE_URL=http://100.64.0.1:8030

SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_ALERTS_CHANNEL=C0123456789
SLACK_OPS_CHANNEL=C0123456790
SLACK_ALLOWED_USERS=["U0123456789","U0123456790"]

NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
ONCALL_PEOPLE=[{"name":"Alice","slack_user_id":"U0123456789","ntfy_topic":"ops-alice-<random>"},{"name":"Bob","slack_user_id":"U0123456790","ntfy_topic":"ops-bob-<random>"}]
ONCALL_ANCHOR=2026-10-19

HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>

# The analysis agent (Anthropic API). Leave empty to keep it off.
ANTHROPIC_API_KEY=
# The three models must be priced in app/agent/pricing.py (a model without a price would be billed at Opus rates),
# so a new model needs a code change first.
# Stages: the automatic run uses AGENT_FALLBACK_MODEL, "Tiefer analysieren" AGENT_MODEL, "Mit Opus analysieren" AGENT_DEEP_MODEL
# AGENT_MODEL=claude-sonnet-5-5
# AGENT_DEEP_MODEL=claude-opus-5-5  (must differ from AGENT_MODEL and AGENT_FALLBACK_MODEL, startup fails otherwise)
# AGENT_MAX_ITERATIONS=12
# AGENT_MAX_TOKENS=8000
# AGENT_TIMEOUT_SECONDS=300
# AGENT_DAILY_BUDGET_USD=5
# AGENT_AUTO_ANALYZE=true
# AGENT_MAX_PARALLEL=2
# AGENT_FALLBACK_MODEL=claude-haiku-5-5

# Security checks (deploy/host-agent). One token per server (openssl rand -hex 32); without them reports are refused.
HOST_REPORT_TOKENS={"app-1":"<token-app-1>","ops-server":"<token-ops>"}
# Servers that run the collector; an expected report that stops arriving opens a P2 HostReportMissing.
SECURITY_HOSTS=["app-1","ops-server"]
# Servers that reboot on their own after updates; the others get a reboot question in the ops channel.
SELF_REBOOTING_HOSTS=["ops-server"]
# SSH login review (reads the `ssh` report of the collector). SSH_KNOWN_USERS: list every user your CI or deploy
# pipeline logs in with, as well as the people's own accounts; a login by any other user opens an SSH alert, and
# each deploy by an unlisted user raises one. Defaults: ["root","deploy"].
SSH_KNOWN_USERS=["root","deploy"]
# Users that may log in at night (quiet hours in TIMEZONE), typically the pipeline user. Default: ["deploy"].
SSH_ANY_TIME_USERS=["deploy"]
# Coolify database UUIDs whose backups are checked through the Coolify API (needs COOLIFY_URL and COOLIFY_TOKEN).
BACKUP_DATABASES=["<coolify-database-uuid>"]

# OSV scan of the dependencies (nightly 02:30): repository -> its repository access token (Repository settings >
# Access tokens, scope `repository` read only). Workspace tokens would need Bitbucket Premium.
BITBUCKET_READ_TOKENS={"acme/api":"<token>","acme/web":"<token>"}

# Coolify version check (weekly report) and backup check. API token with read rights only; use the Tailscale IP,
# the container does not resolve Tailscale names.
COOLIFY_URL=
COOLIFY_TOKEN=

# The ops-runner: one token per server (openssl rand -hex 32), and the Ed25519 signing key (32 byte seed in
# base64, see runner/README.md). The public key goes to the app servers. Without the key no job is delivered.
RUNNER_TOKENS={"app-1":"<token-app-1>","ops-server":"<token-ops>"}
RUNNER_SIGNING_KEY=
# Health URLs per server: after every action the ops service checks that all answer 2xx (red for 5 minutes, 10 after a
# reboot: P1 with the rollback hint). Use the public URLs the collector's HEALTH_URLS use.
RUNNER_HEALTH_URLS={"app-1":["https://api.<domain>/health","https://<domain>/api/health"]}
# The Coolify applications an action may touch, per server: UUID -> name (Coolify: the application's UUID in its URL).
# Without an entry the runbooks that take an application cannot be proposed or created.
RUNNER_APPLICATIONS={"app-1":{"<coolify-app-uuid-api>":"api","<coolify-app-uuid-web>":"web"}}

# Fix pull requests: repository -> Bitbucket repository access token with the scopes repository:write and
# pullrequest:write (Repository settings > Access tokens). The ops service writes only branches named ops-fix/... and
# opens pull requests; it never merges. Protect the main branch against direct pushes in the repository as well, and
# give pull-request pipelines for ops-fix/** no secured variables (deployment variables only for the main branch).
BITBUCKET_WRITE_TOKENS={}
