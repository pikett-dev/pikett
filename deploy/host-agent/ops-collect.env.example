# /etc/ops-collect.env on each server (mode 600, root). Read by ops-collect.py and the systemd units.
OPS_URL=http://<tailscale-ip-of-the-ops-server>:8030
# This server's token from HOST_REPORT_TOKENS in ops-service.env on the ops server.
HOST_REPORT_TOKEN=
# Must match an entry of SECURITY_HOSTS in ops-service.env.
HOST_NAME=app-1

# What each timer collects on this server (space separated). Leave a list empty to skip that timer.
HOURLY_KINDS=
# trivy last: it is the slow one, so the others are sent even when the scans run long.
DAILY_KINDS=patches images ssh crowdsec trivy
WEEKLY_KINDS=lynis

# Trivy scan of the running images (kind trivy). The client runs as a container of this image against the
# trivy-server on the ops server; keep the tag equal to the one in deploy/ops-server/compose.yml.
TRIVY_SERVER=http://<tailscale-ip-of-the-ops-server>:4954
TRIVY_TOKEN=
TRIVY_IMAGE=aquasec/trivy:0.76.2@sha256:8f6bb947dbc528902e11f2f5be52f7b519f6a39d5d148f41166f2040499768fb

# Patch window (kind patches): health URLs that must answer 2xx after the window (space separated).
# App servers: the public health URLs of your applications; ops server: http://127.0.0.1:8030/health is not reachable from the
# host (bound to the Tailscale IP), so use http://<tailscale-ip>:8030/health.
HEALTH_URLS=
