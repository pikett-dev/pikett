[Unit]
Description=Collect daily security facts for the ops service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ops-collect.env
# $DAILY_KINDS (without braces) is split into one argument per kind.
ExecStart=/usr/bin/python3 /opt/ops-collect/ops-collect.py $DAILY_KINDS
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=3h
