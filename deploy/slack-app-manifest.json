{
  "display_information": {
    "name": "Pikett"
  },
  "features": {
    "bot_user": {
      "display_name": "Pikett",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/oncall",
        "description": "Who is on call this week and next?",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "commands"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
