# /etc/ops-runner/ops-runner.env on each app server (mode 600, root). Read by systemd, never by the runner user.
# The ops service over Tailscale (the runner opens no port). Use the Tailscale IP of the ops server.
OPS_URL=http://<tailscale-ip-of-the-ops-server>:8030
# This server's token from RUNNER_TOKENS in ops-service.env on the ops server.
RUNNER_TOKEN=
# Must be a key of RUNNER_TOKENS and the name the jobs use for this server.
HOST_NAME=app-1
# Seconds between polls; the heartbeat alarm fires after 3 minutes without a poll.
POLL_SECONDS=10

# Coolify on this server, reached on localhost (the unit allows only localhost and Tailscale; only a server that runs Coolify; list its applications in RUNNER_APPLICATIONS). The token needs the permissions `read` and `deploy` and nothing else,
# limited to the applications below. Leave empty to turn the Coolify runbooks off.
COOLIFY_URL=
COOLIFY_TOKEN=
# Application UUIDs the runner may restart or roll back (comma separated); the catalog pattern is the first check, this
# list the second.
COOLIFY_APPS=
