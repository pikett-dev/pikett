# Local settings; see app/config.py for all of them. On the server they live in deploy/ops-server/ops-service.env.
ENVIRONMENT=local
LOG_LEVEL=INFO
SERVICE_VERSION=dev
DATABASE_URL=postgresql+asyncpg://ops:ops@localhost:5436/ops
BASE_URL=http://localhost:8030
# LANGUAGE is en or de. TIMEZONE is an IANA time zone. It sets displayed times, the day of the digest and the AI budget, the on-call week, SSH quiet hours, the reboot window and how patch logs are read. Use the zone of your servers: the timers in deploy/ say Europe/Vienna.
LANGUAGE=en
TIMEZONE=UTC

# Without both Slack tokens, messages are only logged.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALERTS_CHANNEL=C0123456789
# SLACK_OPS_CHANNEL=C0123456790
# SLACK_ALLOWED_USERS=["U0123456789"]

# NTFY_URL=https://ntfy.sh
# ONCALL_PEOPLE=[{"name":"Alice","slack_user_id":"U0123456789","ntfy_topic":"ops-alice-<random>"}]
# HEALTHCHECKS_PING_URL=https://hc-ping.com/<uuid>
