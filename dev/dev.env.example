# Values for the local all-in-one stack (see dev/compose.sh). Local development only, nothing here is a real secret.
TAILSCALE_IP=127.0.0.1
OPS_DB_PASSWORD=ops
KUMA_DB_PASSWORD=kuma
KUMA_DB_ROOT_PASSWORD=kuma-root
OPS_IMAGE=pikett:dev
ALERT_NOTIFIER_URL=http://ops-service:8030
# Bearer token of the alert webhook. dev/compose.sh writes it to deploy/ops-server/alert-token for vmalert, and
# dev/alert.sh sends it. A fixed value for local use only.
ALERT_TOKEN=dev-only-alert-token-not-a-secret-0123456789
