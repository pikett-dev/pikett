# Settings of the local ops-service. dev/compose.sh copies this to dev/ops-service.env on first use.
ENVIRONMENT=dev
BASE_URL=http://localhost:8030
# LANGUAGE is en or de. TIMEZONE is an IANA time zone. It sets displayed times, the day of the digest and the AI budget, the on-call week, SSH quiet hours, the reboot window and how patch logs are read. Use the zone of your servers: the timers in deploy/ say Europe/Vienna.
LANGUAGE=en
TIMEZONE=UTC
ONCALL_ANCHOR=2026-10-19
ONCALL_PEOPLE=[{"name":"Alice","slack_user_id":"U_ALICE","ntfy_topic":"dev-alice"},{"name":"Bob","slack_user_id":"U_BOB","ntfy_topic":"dev-bob"}]
NTFY_URL=http://ntfy:80

# Slack works from this machine too (Socket Mode needs no public URL). Create the app from
# deploy/slack-app-manifest.json, then fill in the tokens, channel ids and your user id:
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_ALERTS_CHANNEL=C0123456789
# SLACK_OPS_CHANNEL=C0123456790
# SLACK_ALLOWED_USERS=["U0123456789"]
